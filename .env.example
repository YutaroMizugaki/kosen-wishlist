# Set to "production" for real deployments. When set, the server refuses to start
# in demo mode (missing Supabase env vars) so misconfiguration is caught early.
# On Vercel production this is inferred automatically from VERCEL_ENV.
APP_MODE=

# Supabase Project Settings > API
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=operator@example.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side only. Never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Maximum submissions accepted from one email address in 24 hours.
MAX_SUBMISSIONS_PER_DAY=3

# Optional: restrict submissions to specific email domains (comma-separated).
# Supports wildcards, e.g. "kosen-ac.jp,*.kosen-ac.jp". Empty = no restriction.
ALLOWED_EMAIL_DOMAINS=

# "auto" (default) publishes submissions immediately. "review" holds them as
# pending until an admin approves them (kept off the public list until then).
SUBMISSION_MODE=auto
